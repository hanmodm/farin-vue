<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="myOneService">
	<select id="getTest" parameterType="HMap" resultType="HMap">
		SELECT
			 ROUND(DBMS_RANDOM.VALUE(0, 100)) AS ID
			,DBMS_RANDOM.STRING('U', 20) AS NM
		FROM DUAL
	</select>
</mapper>